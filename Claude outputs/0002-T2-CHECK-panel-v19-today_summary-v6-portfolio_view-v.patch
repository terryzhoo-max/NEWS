+// 2026-11-13 跟踪止盈 T2 界面 (docs/TRAILING_ANCHOR_FIX_PLAN.md F2 / 第 5 节 D6) — node tests/test_trailing_check_ui.cjs
+// CHECK (止损线 / 兜底价 ≤ 0 需核对) 进入每日摘要: ① 决策中枢「今日结论」止损项附注"x 只需核对" (不计入已触发);
+// ② 跟踪止盈面板结论句与状态标签、分组排在遗留之后; ③ 行下显示封顶 / 剔除首日 / 需核对说明; ④ 组合页持仓表状态标签; ⑤ 版本号。
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+const root = path.join(__dirname, '..');
+const read = (p) => fs.readFileSync(path.join(root, p), 'utf8');
+
+// ① 今日结论
+{
+    const src = read('static/js/decision/today_summary.js');
+    const mk = () => { const cls = new Set(); const val = { textContent: '--' };
+        return { val, title: '', classList: { add: (...c) => c.forEach((x) => cls.add(x)), remove: (...c) => c.forEach((x) => cls.delete(x)), has: (c) => cls.has(c) },
+                 querySelector: () => val, removeAttribute() { this.title = ''; } }; };
+    const items = { exec: mk(), compliance: mk(), stops: mk() };
+    const L = {};
+    vm.runInNewContext(src, { window: { addEventListener: (n, f) => { L[n] = f; } },
+        document: { querySelector: (sel) => items[(sel.match(/data-sum="(\w+)"/) || [])[1]] || null }, isFinite, Array });
+    L['ac:trailing']({ detail: { summary: { CHECK: 1, GREEN: 12 } } });
+    assert.equal(items.stops.val.textContent, '0 只 · 1 只需核对');
+    assert(items.stops.classList.has('s-warn') && /需核对/.test(items.stops.title));
+    L['ac:trailing']({ detail: { summary: { RED: 1, CHECK: 1 } } });
+    assert.equal(items.stops.val.textContent, '1 只 · 1 只需核对');
+    assert(items.stops.classList.has('s-block'));
+    L['ac:trailing']({ detail: { summary: { GREEN: 13 } } });
+    assert.equal(items.stops.val.textContent, '0 只');
+    assert(items.stops.classList.has('s-pass'));
+}
+
+// ②③ 跟踪止盈面板
+async function panel(data) {
