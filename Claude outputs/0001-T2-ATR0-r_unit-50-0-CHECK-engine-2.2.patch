diff --git a/quant_dashboard/tests/test_trailing_stop_sanity.py b/quant_dashboard/tests/test_trailing_stop_sanity.py
new file mode 100644
index 0000000..a165a3a
--- /dev/null
+++ b/quant_dashboard/tests/test_trailing_stop_sanity.py
@@ -0,0 +1,123 @@
+"""跟踪止盈 止损线合理性下限 (2026-11-13 T2, docs/TRAILING_ANCHOR_FIX_PLAN.md F2 / 第 5 节 D1 / D3 / D6)
+
+① 锚点之前没有有效 ATR (新股前 atr_period 根内): ATR0 = min(原算法首个有效 ATR, 第 2 至第 atr_period+1 根真实波幅均值)
+   —— 剔除上市首日, 且只会让止损线上移;
+② r_unit 超过成本 50% → 按 50% 封顶并标注 stop_sanity=capped;
+③ 止损线 / 兜底价 ≤ 0 → 状态 CHECK (止损线需核对): 排在 LEGACY 之后, 不生成条件单, 日终不发布, 进入每日摘要与推送;
+正常持仓逐值不变。
+"""
+import os
+import sys
+
+import numpy as np
+import pandas as pd
+import pytest
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from services import trailing_stop_service as svc  # noqa: E402
+from services.trailing_stop import (  # noqa: E402
+    DEFAULT_CONFIG, STATUS_ORDER, PositionInput, evaluate_position, normalize_bars, wilder_atr,
+)
+
+
+def _ohlc(rows, start="2026-07-27"):
+    idx = pd.bdate_range(start, periods=len(rows))
+    o, h, lo, c = (np.array([r[i] for r in rows], dtype=float) for i in range(4))
+    return pd.DataFrame({"trade_date": idx.strftime("%Y%m%d"), "open": o, "high": h, "low": lo, "close": c})
+
+
+def _listing(first_tr=16.92, later_tr=4.0, n=74, base=45.0):
+    """上市首日波幅极大, 之后正常: 模拟长鑫 688825 (首日 55.03 / 38.11)。"""
+    rows = [(49.0, 49.0 + first_tr / 2, 49.0 - first_tr / 2, 49.0)]
+    for i in range(1, n):
+        c = base + 2 * np.sin(i / 5)
+        rows.append((c, c + later_tr / 2, c - later_tr / 2, c))
+    return _ohlc(rows)
+
+
+def _pos(cost, anchor, code="688825.SH", **k):
+    return PositionInput(ts_code=code, name="长鑫科技", qty=903, cost=cost, anchor_date=anchor,
+                         anchor_quality="inferred_cost", tracking_since="2026-10-23", **k)
+
+
+def _tr_mean_ex_first(bars, period=20):
+    b = normalize_bars(bars)
+    prev = b["close"].shift(1)
+    tr = pd.concat([b["high"] - b["low"], (b["high"] - prev).abs(), (b["low"] - prev).abs()], axis=1).max(axis=1)
+    return float(tr.iloc[1:period + 1].mean())
+
+
+def test_listing_day_anchor_excludes_first_day_true_range():
+    bars = _listing()
+    old_atr0 = float(wilder_atr(normalize_bars(bars), 20).dropna().iloc[0])
+    new_atr0 = _tr_mean_ex_first(bars)
+    assert new_atr0 < old_atr0
+    r = evaluate_position(_pos(41.441, "2026-07-27"), bars, cfg=DEFAULT_CONFIG)
+    assert r["r_unit"] == pytest.approx(5 * new_atr0, abs=1e-3)
+    assert r["stop"] > 0 and r["stop_sanity"] == "atr0_listing"
+
+
+def test_listing_rule_takes_smaller_so_stop_never_lower():
+    # 首日波幅很小、之后很大: 剔除首日的均值反而更大 → 取原算法 (止损线不比改前低)
+    bars = _listing(first_tr=0.2, later_tr=3.0)
+    old_atr0 = float(wilder_atr(normalize_bars(bars), 20).dropna().iloc[0])
+    assert _tr_mean_ex_first(bars) > old_atr0
+    r = evaluate_position(_pos(45.0, "2026-07-27"), bars, cfg=DEFAULT_CONFIG)
+    assert r["r_unit"] == pytest.approx(max(5 * old_atr0, 0.03 * 45.0), abs=1e-3)
+    assert r.get("stop_sanity") in (None, "")
+
+
+def test_r_unit_capped_at_half_of_cost_and_flagged():
+    rows = [(200.0, 220.0, 180.0, 200.0)] * 60          # ATR ≈ 20 → 5×ATR = 100 > 50% × 190
+    bars = _ohlc(rows, start="2026-08-03")
+    r = evaluate_position(_pos(190.0, "2026-09-15", code="002916.SZ"), bars, cfg=DEFAULT_CONFIG)
+    assert r["r_unit"] == pytest.approx(95.0, abs=1e-6)
+    assert r["stop"] == pytest.approx(95.0, abs=0.01)
+    assert r["stop_sanity"] == "capped" and "50%" in r["stop_note"]
+
+
+def _check_bars():
+    # 前段平稳, 最后几日剧烈波动: ATR_now 超过封顶后的止损线 → 兜底价 ≤ 0
+    rows = [(100.0, 101.0, 99.0, 100.0)] * 50 + [(100.0, 400.0, 1.0, 100.0)] * 12
+    return _ohlc(rows, start="2026-08-03")
+
+
+def test_non_positive_stop_or_disaster_is_check_not_green():
+    r = evaluate_position(_pos(100.0, "2026-08-20", code="300001.SZ"), _check_bars(), cfg=DEFAULT_CONFIG)
+    assert r["disaster_stop"] <= 0 or r["stop"] <= 0
+    assert r["status"] == "CHECK" and "需核对" in r["action"] and r["sell_qty"] == 0
+    assert STATUS_ORDER["LEGACY"] < STATUS_ORDER["CHECK"] < STATUS_ORDER["ACTION"]
+
+
+def test_normal_positions_unchanged():
+    path = [10.0] * 40 + list(np.linspace(10, 14, 40)) + list(np.linspace(14, 12, 15))
+    idx = pd.bdate_range("2026-06-01", periods=len(path))
+    c = pd.Series(path, index=idx)
+    bars = pd.DataFrame({"trade_date": idx.strftime("%Y%m%d"), "open": c.values, "high": (c * 1.01).values,
+                         "low": (c * 0.99).values, "close": c.values})
+    r = evaluate_position(PositionInput("159949.SZ", "创业板50ETF", 30000, 10.0, idx[40].strftime("%Y-%m-%d"), "exact"),
+                          bars, cfg=DEFAULT_CONFIG)
+    assert r.get("stop_sanity") in (None, "") and r["status"] in ("RED", "GREEN", "YELLOW", "ACTION")
+
+
+def test_check_rows_not_ordered_not_published_and_in_summary_and_alerts(tmp_path, monkeypatch):
+    monkeypatch.setattr(svc, "STATE_PATH", str(tmp_path / "state.json"))
+    monkeypatch.setattr(svc, "SNAPSHOT_DIR", str(tmp_path / "snapshots"))
+    monkeypatch.setattr(svc, "LIVE_RISK_PATH", str(tmp_path / "risk_state_live.json"))
+    svc.save_state({"positions": {}, "audit": [], "tracking_since": "2026-06-01"})
+    store = {"import_date": "2026-11-03", "positions": {"300001.SZ": {"name": "特锐德", "amount": 100, "cost": 100.0}}}
+    ledger = {"trades": [{"date": "2026-08-20", "time": "10:00:00", "ts_code": "300001.SZ", "side": "buy", "qty": 100,
+                          "amount": 10000, "key": "a"}], "imports": []}
+    bars = _check_bars()
+    rep = svc.build_report(store=store, ledger=ledger, bars_loader=lambda c: bars, regime="RANGE", aiae_regime=None,
+                           today=pd.Timestamp(normalize_bars(bars).index[-1]).strftime("%Y-%m-%d"))
+    row = rep["positions"][0]
+    assert row["status"] == "CHECK"
+    assert rep["summary"].get("CHECK") == 1
+    assert not [o for o in rep["orders"] if o["ts_code"] == "300001.SZ"]
+    assert any(a["type"] == "CHECK" and a["ts_code"] == "300001.SZ" for a in rep["actions"])
+    svc.commit_eod(rep, regime="RANGE", today=rep["as_of"])
+    assert "published" not in (svc.load_state()["positions"].get("300001.SZ") or {})
+    fired = svc.scan_and_alert(rep, push=False)
+    assert any(a["rule_id"] == "trailing_check" for a in fired)
-- 
