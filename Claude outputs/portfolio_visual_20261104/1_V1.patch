+// 2026-11-04 组合页视觉轮 (docs/PORTFOLIO_SLIMMING_PLAN.md 第 10 节) (node tests/test_portfolio_visual.cjs)
+// 只做静态 / 沙箱检查, 不改任何口径: 色值变量只在 ac_tokens.css、可见区域无 emoji / 渐变 / 毛玻璃 / 循环动画 / 阴影、
+// 红涨绿跌、英文清理、隐藏模块与权威收尾轮内容不受影响。
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+const root = path.join(__dirname, '..');
+const read = p => fs.readFileSync(path.join(root, p), 'utf8');
+
+const html = read('portfolio.html');
+const css = read('static/css/portfolio.css');
+const pm = read('static/js/portfolio_manager.js');
+const EMOJI = /[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}\u{2B00}-\u{2BFF}\u{FE0F}▶▼●⏳↻]/u;
+
+// ── 可见区域 HTML: 去掉侧栏 (全站导航, 本轮不动) 与隐藏模块 (config/portfolio_modules.json 关闭) ──
+function cut(src, startMark, endMark) {
+    const a = src.indexOf(startMark);
+    assert(a >= 0, `标记缺失: ${startMark}`);
+    const b = src.indexOf(endMark, a + startMark.length);
+    assert(b > a, `标记缺失: ${endMark}`);
+    return src.slice(0, a) + src.slice(b);
+}
+function cutLine(src, needle) {
+    const i = src.indexOf(needle);
+    assert(i >= 0, `缺少: ${needle}`);
+    const a = src.lastIndexOf('\n', i), b = src.indexOf('\n', i);
+    return src.slice(0, a) + src.slice(b);
+}
+let visible = html.slice(html.indexOf('<main'), html.indexOf('<script src="./static/js/portfolio_modules.js'));
+visible = cut(visible, '<div class="pf-alert-strip" id="pf-alerts-risk">', '<!-- ═══ 成交记录');   // 行业饼图 / Brinson / 历史模拟 / 三因子 / 滑点
+visible = cut(visible, '<!-- ═══ 交易弹窗 ═══ -->', '<!-- ═══ 导入持仓弹窗 ═══ -->');
+assert(visible.includes('<!-- ═══ 清零确认弹窗 ═══ -->'));
+visible = visible.slice(0, visible.indexOf('<!-- ═══ 清零确认弹窗 ═══ -->'));          // 清零弹窗 (reset_button 关闭) 位于最后
+visible = cutLine(visible, 'id="reset-btn"');
+visible = cutLine(visible, 'id="open-trade-btn"');
+visible = cutLine(visible, 'id="pf-sparkline"');
+
+// 1) ac_tokens.css 先于页面样式加载; portfolio.css 不定义色值变量
+const links = [...html.matchAll(/<link rel="stylesheet" href="\.\/static\/css\/([\w_]+)\.css/g)].map(m => m[1]);
+assert.equal(links[0], 'ac_tokens', `ac_tokens.css 须最先加载: ${links.join(',')}`);
+assert(links.indexOf('ac_tokens') < links.indexOf('portfolio'));
+assert(!/^\s*--[\w-]+\s*:/m.test(css), 'portfolio.css 不得定义 CSS 变量');
+
+// 2) portfolio.css 可见模块一节: 只用 var(), 无渐变 / 毛玻璃 / 循环动画 / 阴影 / 位移
+const vs = css.indexOf('VISIBLE-START'), ve = css.indexOf('VISIBLE-END'), hs = css.indexOf('HIDDEN-MODULES');
+assert(vs > 0 && ve > vs && hs > ve, '可见 / 隐藏两节标记缺失');
+const vcss = css.slice(vs, ve).replace(/\/\*[\s\S]*?\*\//g, '');
+assert(!/#[0-9a-fA-F]{3,8}(?![\w-])|rgba?\(|hsla?\(/.test(vcss), '可见模块样式出现字面色值 (只用 var)');
+assert(!/gradient\(/.test(vcss), '可见模块样式含渐变');
+assert(!/infinite|@keyframes/.test(vcss), '可见模块样式含循环 / 关键帧动画');
+for (const m of vcss.matchAll(/backdrop-filter\s*:\s*([^;!]+)/g)) assert.equal(m[1].trim(), 'none', '毛玻璃');
+for (const m of vcss.matchAll(/box-shadow\s*:\s*([^;!]+)/g)) assert.equal(m[1].trim(), 'none', `阴影: ${m[1]}`);
+for (const m of vcss.matchAll(/(?:^|[;{\s])transform\s*:\s*([^;!]+)/g)) {
+    assert(/^(none|rotate\(-?\d+deg\))$/.test(m[1].trim()), `位移 / 缩放: ${m[1]}`);   // 只允许 chevron 旋转
+}
+for (const m of vcss.matchAll(/animation\s*:\s*([^;!]+)/g)) assert.equal(m[1].trim(), 'none', `动画: ${m[1]}`);
+// 面板: 实底 + 1px 线 + 6px 圆角 (glass-panel 类名保留: 折叠逻辑与模块测试依赖)
+assert(/\.pf-content \.glass-panel[\s\S]*?background:\s*var\(--dc-surface\)[\s\S]*?border:\s*1px solid var\(--dc-line\)[\s\S]*?border-radius:\s*var\(--dc-radius\)/.test(vcss));
+// 隐藏模块一节: 只含隐藏模块选择器
+const hcss = css.slice(hs).replace(/\/\*[\s\S]*?\*\//g, '');
+for (const m of hcss.matchAll(/(^|})\s*([^{}@]+?)\s*\{/g)) {
+    const sel = m[2].trim();
+    if (/^(from|to|\d+%|0%, 100%)/.test(sel)) continue;
+    assert(/(slip-|pf-slippage-panel|brinson-|pf-chart|pf-charts-row|pf-gauge|pf-btn-adjust|#trade-modal|#reset-modal|pf-reset|btn-reset|pf-hist-reset|pf-btn-reset)/.test(sel),
+        `隐藏模块一节出现可见模块选择器: ${sel}`);
+}
+
+// 3) 可见区域无 emoji、无内联颜色 / 渐变 / 阴影; 第 3.1 节英文字符串不再出现; 页面标题与导航一致
+assert(!EMOJI.test(visible), `可见区域含 emoji: ${(visible.match(EMOJI) || [])[0]}`);
+for (const m of visible.matchAll(/style="([^"]*)"/g)) {
+    assert(!/color|gradient|shadow|background/i.test(m[1]), `内联样式含颜色 / 阴影: ${m[1]}`);
+}
+for (const s of ['Portfolio Management', 'TOTAL NET ASSET VALUE', 'CASH', 'MKT VALUE', 'Position Monitoring', 'Import',
+                 'CANCEL', 'TXT → SYSTEM', 'Empty Portfolio', 'LIVE']) {
+    assert(!visible.includes(s), `可见区域仍含: ${s}`);
+}
+assert(!pm.includes('Empty Portfolio'));
+assert(/<h2>投资组合<\/h2>/.test(html), '页面标题应为"投资组合" (与导航一致)');
+assert(html.includes('<span>投资组合</span>'));
+assert(!html.includes('pf-live-badge'), '"● LIVE" 为写死的静态文字, 应删除');
+
+// 4) JS: 可见渲染不内联颜色、不渲染 emoji; 涨跌只用语义类
+function fnBody(src, name) {
+    const i = src.indexOf(`function ${name}(`);
+    assert(i >= 0, `缺少函数 ${name}`);
+    let depth = 0, j = src.indexOf('{', i);
+    for (let k = j; k < src.length; k++) {
+        if (src[k] === '{') depth++;
+        else if (src[k] === '}' && --depth === 0) return src.slice(i, k + 1);
+    }
+    throw new Error(name);
+}
+const visibleFns = ['showToast', 'renderValuation', 'renderPositionsTable', 'renderHistory', 'parseAndPreview'];
+for (const name of visibleFns) {
+    const b = fnBody(pm, name);
+    assert(!EMOJI.test(b), `${name} 含 emoji`);
+    assert(!/style="[^"]*(color|background)|\.style\.color|#[0-9a-fA-F]{6}\b/.test(b), `${name} 内联颜色`);
+    assert(!/pf-danger|pf-up\b|pf-gold|pf-accent|weightColor/.test(b), `${name} 仍用旧颜色类`);
+}
+for (const f of ['static/js/portfolio_compliance.js', 'static/js/portfolio_kpis.js', 'static/js/lookthrough_panel.js',
+                 'static/js/decision_review_panel.js']) {
+    const src = read(f);
+    assert(!EMOJI.test(src), `${f} 含 emoji`);
+    assert(!/#[0-9a-fA-F]{6}\b|style="[^"]*color|\.style\.color/.test(src), `${f} 内联颜色`);
+    assert(!/slip-kpi|slip-refresh-btn|dr-pos|dr-neg/.test(src), `${f} 仍用旧类名`);
+}
+for (const s of ["'⏳", "'✅", "'🔄", '`✅', '`⚠️']) {
+    const rest = pm.slice(0, pm.indexOf('//  ZONE 6: OMS 滑点归因面板'));   // 隐藏模块 (滑点 / Brinson / 因子) 之前
+    const vis = rest.slice(0, rest.indexOf('//  清零组合功能')) + rest.slice(rest.indexOf('//  同步行情数据'));
+    assert(!vis.includes(s), `可见区 JS 文本含 emoji: ${s}`);
+}
+
+// 5) 涨跌语义类: 正 → ac-up (红), 负 → ac-down (绿), 0 / 缺失 → ac-flat
+const ctx = {};
+vm.runInNewContext(fnBody(pm, 'pnlClass') + '\n' + fnBody(pm, 'stripEmoji') + '\nthis.pnl = pnlClass; this.strip = stripEmoji;', ctx);
+assert.equal(ctx.pnl(1171.7), 'ac-up');
+assert.equal(ctx.pnl(-9874.8), 'ac-down');
+assert.equal(ctx.pnl(0), 'ac-flat');
+assert.equal(ctx.pnl(null), 'ac-flat');
+assert.equal(ctx.strip('✅ 同步完成 🔄 14 只'), '同步完成 14 只');
+assert(/\.ac-up\s*\{\s*color:\s*var\(--mkt-up\)/.test(css) && /\.ac-down\s*\{\s*color:\s*var\(--mkt-down\)/.test(css));
+const tokens = read('static/css/ac_tokens.css');
+assert(/--mkt-up:\s*#f05252/.test(tokens) && /--mkt-down:\s*#22b573/.test(tokens), '红涨绿跌 (ac_tokens)');
+// 决定复盘: 实际收益红涨绿跌; 假设对照 ("若执行") 不着色
+const dr = read('static/js/decision_review_panel.js');
+const dctx = { console };
+dctx.window = dctx;
+vm.createContext(dctx);
+vm.runInContext(dr, dctx);
+const D = dctx.DecisionReviewPanel;
+const hyp = D.renderDecisionRows([{ decision_id: 'x', decided_on: '2026-11-01', decision_status: 'not_adopted', intent: 'sell', codes: ['600000.SH'],
+    thesis: 't', evaluation: 'hypothetical_direction', items: [{ ts_code: '600000.SH', price_change: -0.05, if_executed: 0.05 }] }], false);
+assert(!/ac-up|ac-down/.test(hyp), '假设对照不按涨跌着色');
+const act = D.renderPortfolioReview({ status: 'ok', paths: [{ label: '实际操作', return: 0.02, max_drawdown: -0.1, end_value: 1 }],
+    value_added_vs_hold: -100, value_added_vs_hold_pct: -0.01 }, false);
+assert(act.includes('class="num ac-up"') && act.includes('class="ac-down"'), '实际收益 / 实际增值红涨绿跌');
+
+// 6) 隐藏模块不受影响: 选择器还在、.pm-off 生效; 权威收尾轮内容还在; 估值时点必填且无默认值
+const mods = read('static/js/portfolio_modules.js');
+for (const sel of ['#pf-sector-zone', '#pf-alerts-risk', '#pf-sparkline', '#pf-brinson-zone', '#pf-nav-zone', '#pf-factor-zone',
+                   '#pf-slippage-zone', '#open-trade-btn', '#trade-modal', '#reset-btn', '#reset-modal']) {
+    assert(mods.includes(`'${sel}'`), `模块开关缺少 ${sel}`);
+    assert(html.includes(`id="${sel.slice(1)}"`), `页面缺少 ${sel}`);
+}
+assert(css.includes('.pm-off { display: none !important; }'));
+assert(html.includes('data-ac-authority-tag') && /id="import-btn" data-ac-account-write="import"/.test(html));
+assert(/id="reset-btn" data-ac-account-write/.test(html) && /id="open-trade-btn" data-ac-account-write/.test(html));
+const valIn = html.match(/<input type="time" id="import-valuation-time"[^>]*>/)[0];
+assert(/\brequired\b/.test(valIn) && !/\bvalue=/.test(valIn), '估值时点 input 必填且无默认值');
+assert(html.includes('class="pf-import-valtime-req">必填'));
+
