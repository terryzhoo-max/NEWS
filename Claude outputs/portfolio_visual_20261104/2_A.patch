+"""组合页视觉轮 A (2026-11-04): valuation 的 price 保留 3 位小数; 市值 / 盈亏 / 权重 / 总资产不变。
+
+方案: docs/PORTFOLIO_SLIMMING_PLAN.md 10.4。ETF 报价到 0.001 (如 159995 收盘 0.836), 原先取 2 位显示为 0.84;
+个股原价本就是 2 位, 不受影响。市值始终用未取整价格计算。
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from portfolio_engine import PortfolioEngine  # noqa: E402
+
+PRICES = {"159995.SZ": 0.836, "510300.SH": 4.175, "588000.SH": 1.34, "688019.SH": 207.0, "002156.SZ": 42.33}
+AMOUNTS = {"159995.SZ": 246200, "510300.SH": 17500, "588000.SH": 269200, "688019.SH": 1143, "002156.SZ": 600}
+
+
+def _engine(tmp_path, monkeypatch):
+    e = PortfolioEngine(store_path=str(tmp_path / "s.json"), history_path=str(tmp_path / "h.json"))
+    e.holdings = {"cash": 18.59, "positions": {c: {"name": c, "amount": a, "cost": 1.0, "import_date": "2026-11-04"}
+                                               for c, a in AMOUNTS.items()}}
+    monkeypatch.setattr(e, "_pick_price", lambda code, pos: (PRICES[code], "tushare"))
+    return e
+
+
+def test_price_keeps_three_decimals(tmp_path, monkeypatch):
+    val = _engine(tmp_path, monkeypatch).get_valuation()
+    by = {p["ts_code"]: p for p in val["positions"]}
+    assert by["159995.SZ"]["price"] == 0.836          # 原先 0.84
+    assert by["510300.SH"]["price"] == 4.175          # 原先 4.17 / 4.18
+    assert by["588000.SH"]["price"] == 1.34
+    assert by["688019.SH"]["price"] == 207.0 and by["002156.SZ"]["price"] == 42.33   # 个股不变
+
+
+def test_market_value_weight_total_unchanged(tmp_path, monkeypatch):
+    val = _engine(tmp_path, monkeypatch).get_valuation()
+    by = {p["ts_code"]: p for p in val["positions"]}
+    mv = {c: PRICES[c] * a for c, a in AMOUNTS.items()}  # 未取整价格 × 数量
+    for c in AMOUNTS:
+        assert by[c]["market_value"] == round(mv[c], 2)
+    total = sum(mv.values()) + 18.59
+    assert val["total_asset"] == round(total, 2)
+    assert by["159995.SZ"]["weight"] == round(mv["159995.SZ"] / total * 100, 2)
