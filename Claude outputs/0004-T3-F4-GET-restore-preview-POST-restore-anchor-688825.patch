+@router.get("/trailing-stops/restore-preview")
+async def get_restore_preview():
+    """F4 只读预览 (2026-11-13 T3): 不写状态 / 快照 / 缓存。"""
+    try:
+        from services.trailing_stop_service import restore_preview
+        return R.ok(await asyncio.to_thread(restore_preview))
+    except Exception as e:
+        logger.exception("restore preview failed")
+        return R.error(str(e), "ERR_RESTORE_PREVIEW")
+
+
+@router.post("/trailing-stops/restore-anchor")
+async def post_restore_anchor(body: RestoreBody, request: Request = None):
+    """F4 写入 (2026-11-13 T3): 权威环境 + 令牌 (中间件) + 写操作日志 + 必填理由; 只接受预览提议的代码与快照日。"""
+    require_authoritative(WRITE_MESSAGE)
+    _wl.attach(request, kind="trailing_anchor_restore", ts_code=body.ts_code[:16], snapshot_date=body.snapshot_date[:10])
+    try:
+        from services.trailing_stop_service import restore_anchor
+        data = await asyncio.to_thread(restore_anchor, body.ts_code, body.snapshot_date, body.reason)
+        _clear_cache()
+        return _wl.finish(request, R.ok(data, "已按快照恢复锚点与止损线下限 (已写入审计日志)"), ok_result="restored")
+    except ValueError as e:
+        return _wl.finish(request, R.error(str(e), "ERR_RESTORE"))
+    except Exception as e:
+        logger.exception("restore anchor failed")
+        return _wl.finish(request, R.error(str(e), "ERR_RESTORE"))
+
+
