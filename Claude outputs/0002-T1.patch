diff --git a/quant_dashboard/tests/test_trailing_anchor_lock.py b/quant_dashboard/tests/test_trailing_anchor_lock.py
new file mode 100644
index 0000000..0022591
--- /dev/null
+++ b/quant_dashboard/tests/test_trailing_anchor_lock.py
@@ -0,0 +1,185 @@
+"""跟踪止盈锚点锁定 (2026-11-13 T1, docs/TRAILING_ANCHOR_FIX_PLAN.md F1 / F1a / F1b / 决定 2)
+
+锚点首次发布后锁定: 加仓、导入成交、对账变化不再改变锚点与止损线; 清仓后解锁; 人工设定 / 重新基准化照旧优先;
+同一锚点、同一日期重新提交时发布值取新旧较高者 (改 core 等参数变化不能放宽已发布止损线)。
+"""
+import os
+import sys
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from services import trailing_stop_service as svc  # noqa: E402
+
+
+def _bars(closes, start="2026-06-01"):
+    idx = pd.bdate_range(start, periods=len(closes))
+    c = pd.Series(closes, index=idx, dtype=float)
+    return pd.DataFrame({"trade_date": idx.strftime("%Y%m%d"), "open": c.values, "high": (c * 1.01).values,
+                         "low": (c * 0.99).values, "close": c.values})
+
+
+# 个股: 10 → 14 (40 日) → 横盘; 台账只覆盖最后一段 → 期初持仓按成本反推锚点
+PATH = [10.0] * 30 + list(np.linspace(10, 14, 40)) + [13.5] * 30
+IDX = pd.bdate_range("2026-06-01", periods=len(PATH))
+BARS = {"300059.SZ": _bars(PATH)}
+LEDGER_START = IDX[80].strftime("%Y-%m-%d")
+
+
+def _d(i):
+    return IDX[i].strftime("%Y-%m-%d")
+
+
+def _setup(tmp_path, monkeypatch):
+    monkeypatch.setattr(svc, "STATE_PATH", str(tmp_path / "state.json"))
+    monkeypatch.setattr(svc, "SNAPSHOT_DIR", str(tmp_path / "snapshots"))
+    monkeypatch.setattr(svc, "LIVE_RISK_PATH", str(tmp_path / "risk_state_live.json"))
+    svc.save_state({"positions": {}, "audit": [], "tracking_since": "2026-06-01"})
+
+
+def _store(amount, cost, date=None):
+    return {"import_date": date or _d(99), "positions": {"300059.SZ": {"name": "东方财富", "amount": amount, "cost": cost}}}
+
+
+def _ledger(*trades):
+    base = [{"date": LEDGER_START, "time": "10:00:00", "ts_code": "300059.SZ", "side": "buy", "qty": 300,
+             "amount": 300 * 13.5, "key": "k0"}]
+    return {"trades": base + list(trades), "imports": []}
+
+
+def _run(store, ledger, today=None, commit=True, bars=None):
+    today = today or _d(99)
+    rep = svc.build_report(store=store, ledger=ledger, bars_loader=lambda c: (bars or BARS).get(c),
+                           regime="BULL", aiae_regime=3, today=today)
+    if commit:
+        svc.commit_eod(rep, regime="BULL", today=today)
+    return rep
+
+
+def _row(rep, code="300059.SZ"):
+    return {r["ts_code"]: r for r in rep["positions"]}.get(code)
+
+
+def test_first_commit_writes_anchor_lock(tmp_path, monkeypatch):
+    _setup(tmp_path, monkeypatch)
+    rep = _run(_store(600, 11.0), _ledger())
+    r = _row(rep)
+    assert r["anchor_quality"] == "inferred_cost"
+    lock = svc.load_state()["positions"]["300059.SZ"]["anchor_lock"]
+    assert lock["date"] == r["anchor_date"] and lock["quality"] == "inferred_cost" and lock["at"]
+
+
+def test_add_changes_cost_but_anchor_and_stop_unchanged(tmp_path, monkeypatch):
+    _setup(tmp_path, monkeypatch)
+    r0 = _row(_run(_store(600, 11.0), _ledger()))
+    # 加仓: 成本被摊薄 / 抬高 → 无锁时成本反推的锚点会跳到别的交易日
+    assert svc.resolve_anchor({"anchor_date": LEDGER_START, "anchor_quality": "pre_window"}, {},
+                              BARS["300059.SZ"], 12.5, _d(99))[0] != r0["anchor_date"]
+    r1 = _row(_run(_store(900, 12.5), _ledger(), commit=False))
+    assert r1["anchor_date"] == r0["anchor_date"]
+    assert r1["anchor_locked"] is True
+    assert r1["stop"] >= r0["stop"]
+
+
+def test_trade_import_changes_reconciliation_but_lock_holds_with_hint(tmp_path, monkeypatch):
+    _setup(tmp_path, monkeypatch)
+    r0 = _row(_run(_store(600, 11.0), _ledger()))
+    # 补导入更早的买入 → 台账可见 0→持仓, anchor_quality 变成 exact 且日期不同 → 不自动改, 只提示 (F1b)
+    early = {"date": _d(50), "time": "10:00:00", "ts_code": "300059.SZ", "side": "buy", "qty": 300,
+             "amount": 300 * 12.0, "key": "k-early"}
+    rep = _run(_store(600, 11.0), _ledger(early), commit=False)
+    r1 = _row(rep)
+    assert r1["anchor_date"] == r0["anchor_date"] and r1["stop"] >= r0["stop"]
+    assert r1["anchor_hint"] and _d(50) in r1["anchor_hint"]
+    assert any(h["ts_code"] == "300059.SZ" and h["ledger_anchor"] == _d(50) for h in rep["anchor_hints"])
+
+
+def test_close_out_unlocks_then_rebuy_gets_new_anchor(tmp_path, monkeypatch):
+    _setup(tmp_path, monkeypatch)
+    _run(_store(600, 11.0), _ledger())
+    other = {"import_date": _d(99), "positions": {"159949.SZ": {"name": "创业板50ETF", "amount": 1000, "cost": 10.0}}}
+    _run(other, {"trades": [], "imports": []}, bars={**BARS, "159949.SZ": _bars([10.0] * 100)})
+    st = svc.load_state()
+    ps = st["positions"].get("300059.SZ", {})
+    assert "anchor_lock" not in ps and "published" not in ps
+    assert any(a["action"] == "anchor_unlock" and a["ts_code"] == "300059.SZ" for a in st["audit"])
+    rebuy = {"date": _d(95), "time": "10:00:00", "ts_code": "300059.SZ", "side": "buy", "qty": 200,
+             "amount": 200 * 13.5, "key": "k-rebuy"}
+    led = {"trades": [rebuy], "imports": []}
+    r = _row(_run({"import_date": _d(99), "positions": {"300059.SZ": {"name": "东方财富", "amount": 200, "cost": 13.5}}},
+                  led, commit=False))
+    assert r["anchor_date"] == _d(95) and r["anchor_quality"] == "exact"
+
+
+def test_empty_report_does_not_unlock(tmp_path, monkeypatch):
+    _setup(tmp_path, monkeypatch)
+    _run(_store(600, 11.0), _ledger())
+    svc.commit_eod({"as_of": _d(99), "generated_at": "x", "positions": [], "summary": {}}, regime="BULL", today=_d(99))
+    assert "anchor_lock" in svc.load_state()["positions"]["300059.SZ"]
+
+
+def test_manual_anchor_beats_lock_and_set_clear_drop_lock(tmp_path, monkeypatch):
+    _setup(tmp_path, monkeypatch)
