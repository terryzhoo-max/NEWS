@@ -347,6 +380,15 @@ def build_report(*, store: Optional[Mapping[str, Any]] = None, ledger: Optional[
                    "status": "NO_DATA", "action": f"计算失败: {e}"}
         row["reconcile_status"] = r.get("status", "no_history")
