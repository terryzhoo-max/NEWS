@@ -0,0 +1,58 @@
+// 2026-11-13 跟踪止盈锚点锁定 T1 界面 (docs/TRAILING_ANCHOR_FIX_PLAN.md F1 / F1b) — node tests/test_trailing_anchor_lock_panel.cjs
+// ① 已锁定的锚点在"建仓锚点"列标"已锁定", 悬停说明锁定规则; ② 台账建仓日与锁定锚点不同 → 行下提示 (只提示, 不自动改);
+// ③ "设为底仓"按钮说明不放宽已发布止损线; ④ 版本号。
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const assert = require('node:assert/strict');
+const root = path.join(__dirname, '..');
+const read = (p) => fs.readFileSync(path.join(root, p), 'utf8');
+const tsJs = read('static/js/decision/trailing_stop_panel.js');
+
+const POS = (o) => ({ ts_code: '688825.SH', name: '长鑫科技', status: 'GREEN', asset_class: 'stock', sleeve: 'satellite',
+    weight: 0.03, close: 39.98, cost: 41.441, gain_pct: -0.035, stop: 26.04, distance_atr: 4.8, distance_pct: 0.35,
+    stage: 0, stage_label: 'S0 初始止损', params: { init_k: 5, trail_k: 4, trail_start_r: 1 }, open_risk: 12000, risk_pct: 0.008,
+    anchor_date: '2026-11-02', anchor_quality: 'exact', anchor_note: '台账可见 0→持仓 的建仓日', path: { d: [], c: [], s: [] }, ...o });
+
+function fixture(positions) {
+    return { as_of: '2026-11-13', summary: { GREEN: positions.length }, equity: 1409000,
+        heat: { breached_pct: 0, heat_pct: 0.05, limit_pct: 0.12, breached_market_value: 0 },
+        correlation: { n_eff: 2.1, n: 13, avg_corr: 0.61 }, discipline: { score: null }, averaging_down: { count: 0 },
+        actions: [], positions, meta: { config_hash: 'abc' }, eod: { last_as_of: '2026-11-13' }, params: {}, changes: {},
+        drawdown: { status: 'insufficient' } };
+}
+
+async function render(data) {
+    const nodes = {};
+    const mk = (id) => ({ id, innerHTML: '', textContent: '', hidden: false, dataset: {}, clientWidth: 0,
+        classList: { add() {}, remove() {}, toggle() {}, contains: () => false }, addEventListener() {}, querySelectorAll: () => [] });
+    const node = (id) => (nodes[id] = nodes[id] || mk(id));
+    const doc = { getElementById: (id) => (['trailing-stop-panel', 'ts-body', 'ts-summary', 'ts-dd-chartbox', 'ts-msg'].includes(id) ? node(id) : null),
+        addEventListener() {}, querySelectorAll: () => [] };
+    const resp = { json: async () => ({ status: 'success', data }) };
+    const ctx = { document: doc, console: { warn() {}, log() {}, info() {} }, setTimeout: () => 0, clearTimeout() {}, Math, Number, String, Array,
+        Object, JSON, Date, Promise, isNaN, localStorage: { getItem: () => null, setItem() {} }, fetch: async () => resp,
+        CustomEvent: class { constructor(t, o) { this.type = t; this.detail = o && o.detail; } } };
+    ctx.window = ctx; ctx.addEventListener = () => {}; ctx.dispatchEvent = () => {};
+    vm.createContext(ctx);
+    vm.runInContext(tsJs, ctx);
+    await ctx.loadTrailingStopPanel(false);
+    return nodes['ts-body'].innerHTML;
+}
+
+(async () => {
+    const locked = POS({ anchor_locked: true, anchor_quality: 'inferred_cost', anchor_date: '2026-08-26',
+        anchor_note: '成交记录早于台账 · 首次发布后已锁定: 加仓 / 导入成交 / 对账变化不再改变锚点',
+        anchor_hint: '台账建仓日 2026-09-10 与锁定锚点 2026-08-26 不同; 如需改用台账日期, 请人工设定建仓日 (止损线将按新锚点重算)' });
+    const plain = POS({ ts_code: '002156.SZ', name: '通富微电' });
+    const body = await render(fixture([locked, plain]));
+    const rowOf = (code) => { const i = body.indexOf(`id="ts-row-${code}"`); assert(i >= 0, `缺少行 ${code}`); return body.slice(i, body.indexOf('</tr>', i)); };
+    const r1 = rowOf('688825.SH');
+    assert(r1.includes('成本反推') && r1.includes('ts-lock') && r1.includes('已锁定'), `锁定标注: ${r1}`);
+    assert(r1.includes('首次发布后已锁定'), '悬停说明');
+    assert(!rowOf('002156.SZ').includes('已锁定'), '未锁定的不标');
+    assert(body.includes('台账建仓日 2026-09-10 与锁定锚点 2026-08-26 不同'), '台账建仓日差异提示');
+    assert(/data-act="sleeve"[^>]*title="[^"]*不放宽已发布的止损线/.test(body), '设为底仓按钮说明不放宽止损线');
+    assert.match(read('decision.html'), /trailing_stop_panel\.js\?v=18"/);
+    console.log('test_trailing_anchor_lock_panel: ok');
+})().catch((e) => { console.error(e); process.exit(1); });
